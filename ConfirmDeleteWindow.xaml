<Window x:Class="LiveBell.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除主播" Width="440" Height="288" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <Border Margin="14" Background="#FCFDFE" CornerRadius="24" BorderBrush="#18000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#3500182A" BlurRadius="26" ShadowDepth="7" Opacity=".34"/>
        </Border.Effect>
        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border Width="46" Height="46" Background="#FFF0F3" CornerRadius="15" HorizontalAlignment="Left">
                    <TextBlock Text="−" FontSize="28" Foreground="#E64A78" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Cancel_Click"/>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="删除这位主播？" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="删除" Background="#E95079" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
