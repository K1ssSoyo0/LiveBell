<Window x:Class="LiveBell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="开播铃" Width="1080" Height="720" MinWidth="870" MinHeight="580"
 FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource TextBrush}"
 WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <Window.Resources>
  <Style x:Key="FilterPill" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#71809A"/><Setter Property="Padding" Value="17,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Pill" Background="Transparent" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="White"/><Setter Property="Foreground" Value="#E94F85"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="14" Background="#F7F8FC" CornerRadius="24" BorderBrush="#18000000" BorderThickness="1">
  <Border.Effect><DropShadowEffect Color="#3500182A" BlurRadius="28" ShadowDepth="7" Opacity=".28"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="94"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="28,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="46" Height="46"><Ellipse.Fill><ImageBrush x:Name="HeaderAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><TextBlock Text="开播铃" FontSize="21" FontWeight="Bold"/><Border Background="#EEEFFC" CornerRadius="5" Margin="10,3,0,3" Padding="6,2"><TextBlock Text="v1.2" FontSize="10" Foreground="#7A7CBD" VerticalAlignment="Center"/></Border></StackPanel>
      <TextBlock x:Name="HeaderSubtitleText" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click"/><Button Content="×" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="Close_Click"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="32,8,32,8">
    <StackPanel VerticalAlignment="Center"><TextBlock Text="关注列表" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="刷新" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Refresh_Click"/><Button Content="设置" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Settings_Click"/><Button Content="＋ 添加主播" Click="Add_Click" Padding="18,10"/></StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="32,2,32,12">
    <Border Background="#EEF0F6" CornerRadius="13" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
     <RadioButton Content="全部关注" GroupName="filter" Tag="all" IsChecked="True" Style="{StaticResource FilterPill}" Click="Filter_Click"/>
     <RadioButton Content="直播中" GroupName="filter" Tag="live" Style="{StaticResource FilterPill}" Click="Filter_Click"/>
     <RadioButton Content="已暂停" GroupName="filter" Tag="paused" Style="{StaticResource FilterPill}" Click="Filter_Click"/>
    </StackPanel></Border>
    <Grid Width="250" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="13,10" ToolTip="搜索主播、平台或房间号"/>
     <TextBlock Text="搜索主播 / 房间号" Foreground="#9AA5B8" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Grid>
   <Border Grid.Row="3" Margin="32,0" Background="White" CornerRadius="18" Padding="16,10">
    <Grid>
     <DataGrid x:Name="StreamersGrid" ItemsSource="{Binding StreamersView}" SelectedItem="{Binding SelectedStreamer}"
      AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" IsReadOnly="True"
      Background="White" BorderThickness="0" HeadersVisibility="Column" RowHeight="82" GridLinesVisibility="None"
      HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" MouseDoubleClick="Grid_DoubleClick">
      <DataGrid.CellStyle><Style TargetType="DataGridCell">
       <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#27344D"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="5,0"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers>
      </Style></DataGrid.CellStyle>
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#27344D"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FAFBFE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFF6FA"/></Trigger></Style.Triggers>
      </Style></DataGrid.RowStyle>
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="#8994A8"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F1F3F7"/><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="主播" Width="1.65*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Ellipse Width="46" Height="46" Fill="#E9F0FF"/><Ellipse Width="46" Height="46"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
         <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="#8994A8" Margin="0,5,0,0"><Run Text="房间 "/><Run Text="{Binding RoomId}"/></TextBlock></StackPanel>
        </Grid>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="平台" Width=".55*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PlatformText}" TextAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="开播状态" Width=".85*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Border Background="#F4F5F9" CornerRadius="9" Padding="10,6" HorizontalAlignment="Center"><TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/></Border>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="直播标题" Width="1.65*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Foreground="#64718A" Margin="12,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="自动检查" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding CheckingButtonText}" Background="{Binding CheckingButtonBackground}" Foreground="{Binding CheckingButtonForeground}" FontSize="12" Padding="11,7" HorizontalAlignment="Center" Click="ToggleChecking_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="操作" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="打开" Background="#FFF0F6" Foreground="#E94A82" Padding="12,7" FontSize="12" Click="Open_Click"/><Button Content="···" Style="{StaticResource GhostButton}" Padding="10,6" Margin="7,0,0,0" Click="More_Click" ToolTip="更多操作">
         <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="单独刷新" Click="RefreshOne_Click"/><MenuItem Header="提醒音效" Click="Sound_Click"/><Separator/><MenuItem Header="删除主播" Click="Delete_Click"/></ContextMenu></Button.ContextMenu>
        </Button></StackPanel>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Background="#FFF0F6" CornerRadius="24" Width="72" Height="72" HorizontalAlignment="Center"><TextBlock Text="♡" FontSize="35" Foreground="#EF6B9B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,0"/><TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="4" Margin="34,0"><Ellipse Width="7" Height="7" Fill="#43C77A" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="双击主播即可打开直播间" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#99A3B5" FontSize="12"/></Grid>
  </Grid>
 </Border>
</Window>
