<Window x:Class="LiveBell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开播铃" Width="1020" Height="700" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="14" Background="#FCFDFE" CornerRadius="24" BorderBrush="#18000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#3500182A" BlurRadius="28" ShadowDepth="7" Opacity=".34"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="104"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0">
                    <Ellipse Width="42" Height="42">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Assets/avatar-icon.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="开播铃" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="露露卡妈妈提醒你看直播了" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click"/>
                    <Button Content="×" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="30,12,30,10">
                <StackPanel>
                    <TextBlock Text="关注列表" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="主播开播后，将按你的设置提醒你" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Refresh_Click"/>
                    <Button Content="设置" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Settings_Click"/>
                    <Button Content="＋ 添加主播" Click="Add_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="30,2,30,0" Background="White" CornerRadius="18" Padding="12,4">
                <Border.Effect>
                    <DropShadowEffect Color="#1500182A" BlurRadius="16" ShadowDepth="3" Opacity=".22"/>
                </Border.Effect>
                <Grid>
                    <DataGrid x:Name="StreamersGrid" ItemsSource="{Binding Streamers}" SelectedItem="{Binding SelectedStreamer}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="White" BorderThickness="0" HeadersVisibility="Column"
                              RowHeight="70" GridLinesVisibility="Horizontal" MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#27344D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="#77849A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#EEF1F5"/>
                                <Setter Property="Padding" Value="9,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#EEF1F5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#27344D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="主播" Width="1.45*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="44" Height="44">
                                                <Ellipse Fill="#E9F0FF"/>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="11,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="平台" Width="0.72*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlatformText}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="房间号" Width="0.85*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RoomId}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Border Background="#F3F5F8" CornerRadius="10" Padding="8,5" MinWidth="68" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="检查" Width="0.82*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding CheckingButtonText}" Background="{Binding CheckingButtonBackground}" Foreground="{Binding CheckingButtonForeground}"
                                                Padding="9,6" FontSize="11" HorizontalAlignment="Center" Click="ToggleChecking_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="直播标题" Width="1.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="#42506B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="212">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="音效" Style="{StaticResource GhostButton}" Padding="9,6" FontSize="11"
                                                    Click="Sound_Click" Margin="0,0,6,0"/>
                                            <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="9,6" FontSize="11"
                                                    Click="RefreshOne_Click" Margin="0,0,6,0"/>
                                            <Button Content="打开" Background="#FFF0F6" Foreground="#E94A82" Padding="9,6" FontSize="11"
                                                    Click="Open_Click" Margin="0,0,6,0"/>
                                            <Button Content="删除" Background="#F5F6F8" Foreground="#71809A" Padding="9,6" FontSize="11"
                                                    Click="Delete_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="22" Background="#E8F5FF" HorizontalAlignment="Center">
                            <TextBlock Text="＋" FontSize="32" Foreground="#347AF7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="还没有关注的主播" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="点击“添加主播”，输入直播间号或网址" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="32,0">
                <Ellipse Width="7" Height="7" Fill="#43C77A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBlock Text="关闭窗口后可按设置驻留在右下角" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#A0A8B7" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</Window>
