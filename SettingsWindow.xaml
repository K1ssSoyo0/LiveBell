<Window x:Class="LiveBell.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置" Width="600" Height="690" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource TextBrush}"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#F6F7FB"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#27344D"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="19,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="10" Margin="0,0,5,8" Cursor="Hand"><ContentPresenter x:Name="TabLabel" ContentSource="Header" TextElement.Foreground="#8590A5"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#FFF0F6"/><Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="#E94F85"/><Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,8,22,0"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="42" Height="24" Background="#DCE2ED" CornerRadius="12"><Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" Margin="3" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#F75B91"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="14" Background="#FCFDFE" CornerRadius="24" BorderBrush="#18000000" BorderThickness="1">
  <Border.Effect><DropShadowEffect Color="#3500182A" BlurRadius="26" ShadowDepth="7" Opacity=".28"/></Border.Effect>
  <Grid Margin="28,0">
   <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="70"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <StackPanel VerticalAlignment="Center"><TextBlock Text="设置" FontSize="25" FontWeight="Bold"/><TextBlock Text="让开播铃按你的习惯工作" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
    <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click"/>
   </Grid>
   <TabControl x:Name="SettingsTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0">
    <TabItem Header="提醒"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,5,0">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="提醒方式" FontWeight="SemiBold"/><TextBlock Text="开播时只使用你选中的一种提醒" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="SoftwareNoticeBox" Content="软件内小窗" GroupName="notify"/><RadioButton x:Name="WindowsNoticeBox" Content="Windows 提醒" GroupName="notify"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="默认提醒声音" FontWeight="SemiBold"/><TextBlock x:Name="SoundNameText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal"><Button Content="选择声音" Style="{StaticResource GhostButton}" Click="ChooseSound_Click" Margin="0,0,10,0"/><Button Content="试听" Style="{StaticResource GhostButton}" Click="PreviewSound_Click"/></StackPanel><TextBlock Text="单个主播的音效可以在关注列表的“···”中设置" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="软件内提醒停留时间" FontWeight="SemiBold"/><TextBlock Text="3–3600 秒 · 点击提醒可进入直播间" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBox x:Name="ToastSecondsBox" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" ToolTip="单位：秒"/></Grid></Border>
     <Button Content="查看软件小窗效果" Style="{StaticResource GhostButton}" Click="TestNotice_Click" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="运行"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,5,0">
     <Border Style="{StaticResource Card}"><Grid><StackPanel Margin="0,0,55,0"><TextBlock Text="开机自动启动" FontWeight="SemiBold"/><TextBlock Text="登录 Windows 后自动开始检查" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="AutoStartBox" HorizontalAlignment="Right"/></Grid></Border>
     <Border Style="{StaticResource Card}"><Grid><StackPanel Margin="0,0,55,0"><TextBlock Text="关闭窗口后驻留后台" FontWeight="SemiBold"/><TextBlock Text="隐藏到右下角托盘，继续检查开播状态" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="ResidentBox" HorizontalAlignment="Right"/></Grid></Border>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="检查间隔" FontWeight="SemiBold"/><TextBlock Text="6–3600 秒 · 30 秒通常已经够用" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBox x:Name="IntervalBox" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" ToolTip="单位：秒"/></Grid></Border>
     <TextBlock Text="每位主播都能单独暂停检查。暂停后不会发送开播提醒。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,4"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="外观"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,5,0">
     <Border Style="{StaticResource Card}"><StackPanel>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="62" Height="62" HorizontalAlignment="Left"><Ellipse.Fill><ImageBrush x:Name="AvatarPreviewBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="软件头像" FontWeight="SemiBold"/><TextBlock Text="主界面、任务栏和托盘同步使用" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Grid>
      <StackPanel Orientation="Horizontal"><Button Content="选择头像" Style="{StaticResource GhostButton}" Click="ChooseAvatar_Click" Margin="0,0,10,0"/><Button Content="恢复默认" Style="{StaticResource GhostButton}" Click="ResetAvatar_Click"/></StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="头像旁边的小字" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="HeaderSubtitleBox" MaxLength="40"/><TextBlock Text="任务栏与托盘名称" FontWeight="SemiBold" Margin="0,20,0,10"/><TextBox x:Name="TaskbarLabelBox" MaxLength="60"/></StackPanel></Border>
     <TextBlock Text="点击“保存设置”后应用，取消不会改变原来的头像和声音。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,4"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="关于"><StackPanel Margin="0,12,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LiveBell · 开播铃" FontSize="22" FontWeight="Bold"/><TextBlock Text="v1.2.1 精简版" Foreground="#E94F85" Margin="0,8,0,0"/><TextBlock Text="一个安静、轻巧的桌面开播提醒工具。" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/><TextBlock Text="支持 B站与斗鱼 · 所有数据保存在软件旁的 Data 文件夹" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="源代码与下载包：github.com/K1ssSoyo0/LiveBell" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,5"/></StackPanel></TabItem>
   </TabControl>
   <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#D65465" FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0"/>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="保存设置" Click="Save_Click" Padding="18,10"/></StackPanel>
  </Grid>
 </Border>
</Window>
