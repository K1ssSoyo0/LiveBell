<Window x:Class="LiveBell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" Height="800" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <Border Margin="14" Background="#FCFDFE" CornerRadius="24" BorderBrush="#18000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#3500182A" BlurRadius="26" ShadowDepth="7" Opacity=".33"/>
        </Border.Effect>
        <Grid Margin="28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="提醒和运行方式" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="#F7F9FD" CornerRadius="14" Padding="16,12" Margin="0,0,0,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="提醒方式" FontWeight="SemiBold"/>
                        <TextBlock Text="开播时只使用其中一种提醒" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="SoftwareNoticeBox" Content="软件内" GroupName="notify" Margin="0,0,12,0"/>
                        <RadioButton x:Name="WindowsNoticeBox" Content="Windows" GroupName="notify"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="#F7F9FD" CornerRadius="14" Padding="16,12" Margin="0,0,0,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="默认提醒声音" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SoundNameText" Text="未选择，使用系统提示音" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="试听" Style="{StaticResource GhostButton}" Click="PreviewSound_Click" Padding="11,6" Margin="0,0,7,0"/>
                        <Button Content="选择声音" Style="{StaticResource GhostButton}" Click="ChooseSound_Click" Padding="11,6"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="#F7F9FD" CornerRadius="14" Padding="16,12" Margin="0,0,0,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="开机自动启动" FontWeight="SemiBold"/>
                        <TextBlock Text="登录 Windows 后自动开始监听" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoStartBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="4" Background="#F7F9FD" CornerRadius="14" Padding="16,12" Margin="0,0,0,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="关闭后驻留后台" FontWeight="SemiBold"/>
                        <TextBlock Text="关闭窗口后隐藏到右下角小箭头区域" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="ResidentBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="5" Background="#F7F9FD" CornerRadius="14" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="刷新间隔" FontWeight="SemiBold"/>
                        <TextBlock Text="6 至 3600 秒" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="IntervalBox" Width="72" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="6" Background="#F7F9FD" CornerRadius="14" Padding="16,12" Margin="0,9,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="软件内提醒停留时间" FontWeight="SemiBold"/>
                        <TextBlock Text="3 至 3600 秒；点击提醒可直接打开直播间" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="ToastSecondsBox" Width="72" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="7" Background="#F7F9FD" CornerRadius="14" Padding="16,14" Margin="0,9,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="58" Height="58" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarPreviewBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="个性化外观" FontWeight="SemiBold"/>
                                <TextBlock Text="头像会同步用于主界面、任务栏和托盘" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="选择头像" Style="{StaticResource GhostButton}" Click="ChooseAvatar_Click" Padding="11,6" Margin="0,0,7,0"/>
                                <Button Content="恢复默认" Style="{StaticResource GhostButton}" Click="ResetAvatar_Click" Padding="11,6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="头像旁边的小字" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="HeaderSubtitleBox" MaxLength="40"/>
                        <TextBlock Text="任务栏与托盘标签" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/>
                        <TextBox x:Name="TaskbarLabelBox" MaxLength="60"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText" Grid.Row="8" Foreground="#D65454" FontSize="11" Margin="2,10,0,0"/>
            <Grid Grid.Row="9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="保存设置" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
