<Window x:Class="LiveBell.AddStreamerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加主播" Width="540" Height="390" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PlatformChoice" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#60708A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceRoot" Background="#F5F7FB" BorderBrush="Transparent"
                                BorderThickness="1.5" CornerRadius="13" Padding="15,11">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#AAB6C8" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceRoot" Property="Background" Value="#FFF1F6"/>
                                <Setter TargetName="ChoiceRoot" Property="BorderBrush" Value="#F65B91"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#F65B91"/>
                                <Setter Property="Foreground" Value="#D93F76"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceRoot" Property="Background" Value="#EEF3FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="14" Background="#FCFDFE" CornerRadius="25" BorderBrush="#18000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#3500182A" BlurRadius="27" ShadowDepth="7" Opacity=".34"/>
        </Border.Effect>
        <Grid Margin="30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="添加主播" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="填入直播间号或直接粘贴直播间网址" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="选择平台" FontWeight="SemiBold" Foreground="#3D4B65"/>
            <Grid Grid.Row="2" Margin="0,9,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="BilibiliBox" Content="B站" GroupName="platform"
                             IsChecked="True" Style="{StaticResource PlatformChoice}"/>
                <RadioButton x:Name="DouyuBox" Grid.Column="2" Content="斗鱼" GroupName="platform"
                             Style="{StaticResource PlatformChoice}"/>
            </Grid>

            <TextBlock Grid.Row="3" Text="直播间号或网址" FontWeight="SemiBold" Foreground="#3D4B65"/>
            <Border Grid.Row="4" Margin="0,9,0,0" Background="#F8FAFD" BorderBrush="#DCE4F0" BorderThickness="1" CornerRadius="12">
                <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0" Padding="13,9"
                         FontSize="14"/>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,11,0,0" VerticalAlignment="Top">
                <Border Background="#F0F4FB" CornerRadius="9" Padding="9,5" Margin="0,0,8,0">
                    <TextBlock Text="B站：live.bilibili.com/33989" FontSize="10" Foreground="#71809A"/>
                </Border>
                <Border Background="#FFF1F6" CornerRadius="9" Padding="9,5">
                    <TextBlock Text="斗鱼：douyu.com/6657" FontSize="10" Foreground="#C45076"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="添加主播" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
